{"type":"test-group","name":"Auditoria de Demonstração","description":"Estes testes de exemplo demonstram a funcionalidade e estrutura de auditorias.","tests":[{"type":"test-group","name":"Níveis de Resultado","description":"Estes são todos os diferentes níveis de resultados do teste.","tests":[{"type":"test-case","name":"level-pass","description":"É com isto que o resultado de um teste aprovado sem dados se parece.","test":"function() {\n    return {level: \"pass\"};\n}"},{"type":"test-case","name":"level-warn","description":"É com isto que o resultado de um teste com alerta sem dados se parece.","test":"function() {\n    return {level: \"warn\"};\n}"},{"type":"test-case","name":"level-fail","description":"É com isto que o resultado de um teste com falha sem dados se parece.","test":"function() {\n    return {level: \"fail\"};\n}"},{"type":"test-case","name":"level-error","description":"É com isto que o resultado de um teste que gerou um erro sem dados se parece.","test":"function() {\n    return {level: \"error\"};\n}"},{"type":"test-case","name":"level-unsupported","description":"É com isto que o resultado de um teste incompatível sem dados se parece.","test":"function() {\n    return {level: \"unsupported\"};\n}"}]},{"type":"test-group","name":"Dados de Resultado","description":"Estes testes de exemplo demonstram todos os tipos de dados diferentes que podem ser retornados com o resultado do teste.","tests":[{"type":"test-case","name":"data-domNodes","description":"Este é um exemplo de como os nós DOM de resultado são mostrados. Ele passará com o elemento <body>.","test":"function() {\n    return {level: \"pass\", domNodes: [document.body]};\n}"},{"type":"test-case","name":"data-domAttributes","description":"Este é um exemplo de como os atributos DOM de resultado são destacados em qualquer nó DOM retornado. Ele passará com todos os elementos com um atributo id.","test":"function() {\n    return {level: \"pass\", domNodes: Array.from(document.querySelectorAll(\"[id]\")), domAttributes: [\"id\"]};\n}"},{"type":"test-case","name":"data-errors","description":"Este é um exemplo de como os erros são mostrados. O erro foi gerado manualmente, mas os erros de execução aparecerão da mesma maneira.","test":"function() {\n    throw Error(\"this error was thrown from inside the audit test code.\");\n}"},{"type":"test-case","name":"data-custom","description":"Este é um exemplo de como os dados de resultados personalizados são mostrados.","supports":3,"test":"function() {\n    return {level: \"pass\", a: 1, b: [2], c: {key: 3}};\n}"}]},{"type":"test-group","name":"Dados Especialmente Expostos","description":"Estes testes de exemplo demonstram como usar WebInspectorAudit para acessar informações normalmente não disponíveis para JavaScript.","supports":1,"tests":[{"type":"test-group","name":"Acessibilidade","description":"Estes testes de exemplo demonstram como usar WebInspectorAudit.Accessibility para obter informações sobre a árvore de acessibilidade.","supports":1,"tests":[{"type":"test-case","name":"getElementsByComputedRole","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getElementsByComputedRole para encontrar elementos com uma função computada de “link”.","supports":1,"test":"function() {\n    return {level: \"pass\", domNodes: WebInspectorAudit.Accessibility.getElementsByComputedRole(\"link\"), domAttributes: [\"role\"]};\n}"},{"type":"test-case","name":"getActiveDescendant","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getActiveDescendant para encontrar qualquer elemento que atenda ao critério de herdeiro ativo (“aria-activedescendant”) do elemento <body>, caso ele exista.","supports":1,"test":"function() {\n    let result = {level: \"pass\"};\n    let activeDescendant = WebInspectorAudit.Accessibility.getActiveDescendant(document.body);\n    if (activeDescendant)\n        result.domNodes = [activeDescendant];\n    return result;\n}"},{"type":"test-case","name":"getChildNodes","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getChildNodes para encontrar nós secundários do elemento <body> na árvore de acessibilidade.","supports":1,"test":"function() {\n    let childNodes = WebInspectorAudit.Accessibility.getChildNodes(document.body);\n    return {level: \"pass\", domNodes: childNodes || []};\n}"},{"type":"test-case","name":"getComputedProperties","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getComputedProperties para encontrar uma variedade de informações de acessibilidade sobre o elemento <body>.","supports":3,"test":"function() {\n    let domAttributes = [\"alt\", \"aria-atomic\", \"aria-busy\", \"aria-checked\", \"aria-current\", \"aria-disabled\", \"aria-expanded\", \"aria-haspopup\", \"aria-hidden\", \"aria-invalid\", \"aria-label\", \"aria-labelledby\", \"aria-level\", \"aria-live\", \"aria-pressed\", \"aria-readonly\", \"aria-relevant\", \"aria-required\", \"aria-selected\", \"role\", \"title\"].filter((attribute) => document.body.hasAttribute(attribute));\n    let computedProperties = WebInspectorAudit.Accessibility.getComputedProperties(document.body);\n    return {level: \"pass\", domNodes: [document.body], domAttributes, ...(computedProperties || {})};\n}"},{"type":"test-case","name":"getControlledNodes","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getControlledNodes para encontrar todos os nós controlados (“aria-controls”) pelo elemento <body>, se houver algum.","supports":1,"test":"function() {\n    let controlledNodes = WebInspectorAudit.Accessibility.getControlledNodes(document.body);\n    return {level: \"pass\", domNodes: controlledNodes || []};\n}"},{"type":"test-case","name":"getFlowedNodes","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getFlowedNodes para encontrar todos os nós com fluxo para (“aria-flowto”) do elemento <body>, se houver algum.","supports":1,"test":"function() {\n    let flowedNodes = WebInspectorAudit.Accessibility.getFlowedNodes(document.body);\n    return {level: \"pass\", domNodes: flowedNodes || []};\n}"},{"type":"test-case","name":"getMouseEventNode","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getMouseEventNode para encontrar o nó que controlaria eventos de mouse para o elemento <body>, se aplicável.","supports":1,"test":"function() {\n    let result = {level: \"pass\"};\n    let mouseEventNode = WebInspectorAudit.Accessibility.getMouseEventNode(document.body);\n    if (mouseEventNode)\n        result.domNodes = [mouseEventNode];\n    return result;\n}"},{"type":"test-case","name":"getOwnedNodes","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getOwnedNodes para encontrar todos os nós de propriedade (“aria-owns”) do elemento <body>, se houver algum.","supports":1,"test":"function() {\n    let ownedNodes = WebInspectorAudit.Accessibility.getOwnedNodes(document.body);\n    return {level: \"pass\", domNodes: ownedNodes || []};\n}"},{"type":"test-case","name":"getParentNode","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getParentNode para encontrar o nó principal do elemento <body> na árvore de acessibilidade.","supports":1,"test":"function() {\n    let result = {level: \"pass\"};\n    let parentNode = WebInspectorAudit.Accessibility.getParentNode(document.body);\n    if (parentNode)\n        result.domNodes = [parentNode];\n    return result;\n}"},{"type":"test-case","name":"getSelectedChildNodes","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getSelectedChildNodes para encontrar todos os nós secundários selecionados (“aria-selected”) do elemento <body> na árvore de acessibilidade.","supports":1,"test":"function() {\n    let selectedChildNodes = WebInspectorAudit.Accessibility.getSelectedChildNodes(document.body);\n    return {level: \"pass\", domNodes: selectedChildNodes || []};\n}"}]},{"type":"test-group","name":"DOM","description":"Estes testes de exemplo demonstram como usar WebInspectorAudit.DOM para obter informações sobre nós DOM.","supports":1,"tests":[{"type":"test-case","name":"hasEventListeners","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.hasEventListeners para encontrar dados que indicam se o elemento <body> tem algum ouvinte de evento.","supports":3,"test":"function() {\n    let domAttributes = Array.from(document.body.attributes).filter((attribute) => attribute.name.startsWith(\"on\"));\n    return {level: \"pass\", domNodes: [document.body], domAttributes, hasEventListeners: WebInspectorAudit.DOM.hasEventListeners(document.body)};\n}"},{"type":"test-case","name":"hasEventListeners-click","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.hasEventListenersClick para encontrar dados que indicam se o elemento <body> tem algum ouvinte de evento de clique.","supports":3,"test":"function() {\n    let domAttributes = [\"onclick\"].filter((attribute) => document.body.hasAttribute(attribute));\n    return {level: \"pass\", domNodes: [document.body], domAttributes, hasClickEventListener: WebInspectorAudit.DOM.hasEventListeners(document.body, \"click\")};\n}"}]},{"type":"test-group","name":"Recursos","description":"Estes testes de exemplo demonstram como usar WebInspectorAudit.Resources para obter informações sobre recursos carregados.","supports":2,"tests":[{"type":"test-case","name":"getResources","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getResources para encontrar informações básicas sobre cada recurso.","supports":3,"test":"function() {\n    return {level: \"pass\", resources: WebInspectorAudit.Resources.getResources()};\n}"},{"type":"test-case","name":"getResourceContent","description":"Este é um teste de exemplo que usa WebInspectorAudit.Accessibility.getResourceContent para encontrar o conteúdo do recurso principal.","supports":3,"test":"function() {\n    let resources = WebInspectorAudit.Resources.getResources();\n    let mainResource = resources.find((resource) => resource.url === window.location.href);\n    return {level: \"pass\", mainResource, resourceContent: WebInspectorAudit.Resources.getResourceContent(mainResource.id)};\n}"}]}]},{"type":"test-case","name":"unsupported","description":"Este é um teste de exemplo que não será executado por ser incompatível.","supports":5,"test":"function() {\n    throw Error(\"this test should not be supported.\");\n}"}]}