{"type":"test-group","name":"Níveis de Resultado","description":"Estes são todos os diferentes níveis de resultados do teste.","tests":[{"type":"test-case","name":"level-pass","description":"É com isto que o resultado de um teste aprovado sem dados se parece.","test":"function() {\n    return {level: \"pass\"};\n}"},{"type":"test-case","name":"level-warn","description":"É com isto que o resultado de um teste com alerta sem dados se parece.","test":"function() {\n    return {level: \"warn\"};\n}"},{"type":"test-case","name":"level-fail","description":"É com isto que o resultado de um teste com falha sem dados se parece.","test":"function() {\n    return {level: \"fail\"};\n}"},{"type":"test-case","name":"level-error","description":"É com isto que o resultado de um teste que gerou um erro sem dados se parece.","test":"function() {\n    return {level: \"error\"};\n}"},{"type":"test-case","name":"level-unsupported","description":"É com isto que o resultado de um teste incompatível sem dados se parece.","test":"function() {\n    return {level: \"unsupported\"};\n}"}]}