# Porta SSH Hostinger: 65002 (não é FTP padrão)
SFTP_HOST=72.61.220.147
SFTP_PORT=65002
SFTP_USER=u854441981
SFTP_DEST=domains/dromeflow.com/public_html
SFTP_PASSWORD=sua-senha-aqui
